{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ruletadecomida.es" }],
      "destination": "https://www.ruletadecomida.es/:path*",
      "permanent": true
    },
    {
      "source": "/guia/:food/:city",
      "destination": "/:city/:food/",
      "permanent": true
    },
    {
      "source": "/guia/:food/:city/",
      "destination": "/:city/:food/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
